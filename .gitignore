# Dependencies
node_modules
.pnp
.pnp.*

# Next.js
.next
out
build
next-env.d.ts
tsconfig.tsbuildinfo

# Environment
.env
.env*.local
!.env.example

# Local data — accounts, signed-session secret, recorded sessions, meeting
# rooms, one-shot auth/verification tokens and probe output. Every file here is
# per-machine state, never source, so the directory is ignored as a whole.
data/

# `npm run backup` writes timestamped copies here; never commit account data.
backups/

# Downloaded/copied model runtime — both are restored by `npm install`
# (scripts/setup-assets.mjs copies the WASM out of node_modules and fetches
# the .task bundles). Committing them would put ~19 MB of binaries in history.
public/mediapipe/models/*.task
public/mediapipe/wasm/

# Generated diagnostics — see docs/README.md. docs/README.md itself is tracked.
docs/notes/
docs/logs/
docs/artifacts/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.pem
.vercel
