# Dependencies
node_modules
.pnp
.pnp.*

# Next.js
.next
out
build
next-env.d.ts
tsconfig.tsbuildinfo

# Environment
.env
.env*.local
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# Legacy local JSON exports and probe output are per-machine state, never source.
data/

# Local database exports and legacy data backups may contain account data.
backups/

# Downloaded/copied model runtime — both are restored by `npm install`
# (scripts/setup-assets.mjs copies the WASM out of node_modules and fetches
# the .task bundles). Committing them would put ~19 MB of binaries in history.
public/mediapipe/models/*.task
public/mediapipe/wasm/

# Agent worktrees (.kilo/) — local multi-branch checkouts, never source.
.kilo/

# Generated diagnostics — see docs/README.md. docs/README.md itself is tracked.
docs/notes/
docs/logs/
docs/artifacts/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.pem
.vercel
