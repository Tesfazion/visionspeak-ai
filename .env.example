# Copy to `.env.local` and fill in. Never commit real values.

# Signs the session cookie. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# If unset, a random secret is generated once into data/auth-secret (dev only —
# every restart with a different secret invalidates existing logins).
AUTH_SECRET=

# Optional: public origin, used for absolute URLs in OpenGraph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
