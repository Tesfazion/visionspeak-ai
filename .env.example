# Copy to `.env.local` for local development, or paste into your host's
# environment settings (Vercel → Project → Settings → Environment Variables).

# ---------------------------------------------------------------------------
# AUTH_SECRET — required for any deployment that must keep users signed in.
#
# Generate one:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
#
# If unset, a random secret is generated once into data/auth-secret on a
# writable filesystem. On a serverless host the secret is then per-instance, so
# every cold start signs everyone out. Always set it in production.
# ---------------------------------------------------------------------------
AUTH_SECRET=

# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL — absolute origin, used for OpenGraph URLs, robots.txt
# and sitemap.xml. Set it to your real domain in production.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# VS_DATA_DIR — optional. Where sessions.json / users.json are written.
#
# Unset locally: <repo>/data.
# Unset on Vercel/Lambda/Netlify: the OS temp dir (writable, but wiped on a
# cold start — accounts and sessions do not survive a restart).
# Set it to a mounted volume path to make storage durable.
# ---------------------------------------------------------------------------
VS_DATA_DIR=
