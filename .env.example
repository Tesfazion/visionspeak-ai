# Template only. Set production values in Vercel → Project → Settings →
# Environment Variables. Never commit actual credentials.

# ---------------------------------------------------------------------------
# AUTH_SECRET — required for any deployment that must keep users signed in.
#
# Generate one:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
#
# Required in production. Generate a secret with the command below.
# ---------------------------------------------------------------------------
AUTH_SECRET=

# ---------------------------------------------------------------------------
# DATABASE_URL — required. PostgreSQL is the platform's only persistent store.
# URL-encode reserved characters in credentials (for example, # as %23).
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# AUTH_COOKIE_SECURE — control the Secure flag on the session cookie.
#
# "true"  → always set Secure (for HTTPS-only deployments)
# "false" → never set Secure (for HTTP deployments, local dev, or behind
#           TLS-terminating proxy that sets x-forwarded-proto)
# unset   → auto-detect from request (x-forwarded-proto / request URL protocol)
#
# This is needed when running behind a TLS-terminating proxy where
# x-forwarded-proto is set to https but the actual browser connection
# is HTTP, which would cause the browser to discard a Secure cookie.
# ---------------------------------------------------------------------------
AUTH_COOKIE_SECURE=

# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL — absolute origin, used for OpenGraph URLs, robots.txt
# and sitemap.xml. Set it to your real domain in production.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Billing — optional. Set this to a real checkout (Stripe Payment Link, Lemon
# Squeezy, Paddle) and /pricing starts selling Pro. Leave it empty and the page
# says so plainly instead of pretending to charge: nothing is faked here.
# The plan itself is enforced by src/lib/plans.ts either way.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_PRO_CHECKOUT_URL=

# ---------------------------------------------------------------------------
# BILLING_WEBHOOK_SECRET — shared secret for POST /api/billing/webhook.
#
# The provider sends it in `x-billing-signature`; the route flips that user's
# plan to the body's `plan` ("pro" or "free"). This is the only writer of
# `plan`, which is what the quota checks trust. Unset → the route answers 410 so
# a deploy cannot be talked into upgrading anyone by accident.
# ---------------------------------------------------------------------------
BILLING_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# SMTP — optional. Without SMTP_HOST and SMTP_FROM nothing is sent: signup,
# password reset and report emails log `email.skipped` and the UI says so.
#
# Port 587 (the default) requires STARTTLS — credentials are never written to a
# plaintext connection; a server that does not offer it gets no password.
# Port 465 connects with implicit TLS; set SMTP_SECURE=1 to force that on any
# port. The certificate must validate; there is no "ignore" switch.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---------------------------------------------------------------------------
# Brand — optional. Shown in the UI and in emails. The product name defaults to
# "VisionSpeak"; set these only when white-labelling a deployment.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_BRAND_NAME=
NEXT_PUBLIC_BRAND_TAGLINE=

# ---------------------------------------------------------------------------
# Legal / support — shown on /privacy and /terms and used for deletion requests.
# Set these to real values before you take money or traffic.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_LEGAL_ENTITY=
NEXT_PUBLIC_LEGAL_JURISDICTION=
