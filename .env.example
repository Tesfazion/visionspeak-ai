# Template only. Set production values in Vercel → Project → Settings →
# Environment Variables. Never commit actual credentials.

# ---------------------------------------------------------------------------
# AUTH_SECRET — required for any deployment that must keep users signed in.
#
# Generate one:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
#
# Required in production. Generate a secret with the command below.
# ---------------------------------------------------------------------------
AUTH_SECRET=

# ---------------------------------------------------------------------------
# DATABASE_URL — required. PostgreSQL is the platform's only persistent store.
# URL-encode reserved characters in credentials (for example, # as %23).
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# TEST_DATABASE_URL — required for tests and database-backed integration checks.
# Configure it locally and as a GitHub Actions secret.
#
# Point this only at a dedicated, disposable Neon database/branch. Tests remove
# only records created by their unique test run; never use production data.
# ---------------------------------------------------------------------------
TEST_DATABASE_URL=

# ---------------------------------------------------------------------------
# AUTH_COOKIE_SECURE — control the Secure flag on the session cookie.
#
# "true"  → always set Secure (for HTTPS-only deployments)
# "false" → never set Secure (for HTTP deployments, local dev, or behind
#           TLS-terminating proxy that sets x-forwarded-proto)
# unset   → auto-detect from request (x-forwarded-proto / request URL protocol)
#
# This is needed when running behind a TLS-terminating proxy where
# x-forwarded-proto is set to https but the actual browser connection
# is HTTP, which would cause the browser to discard a Secure cookie.
# ---------------------------------------------------------------------------
AUTH_COOKIE_SECURE=

# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL — absolute site origin used for metadata, reset links,
# robots.txt and sitemap.xml. Set it to your real HTTPS domain in production.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Lemon Squeezy billing. Create recurring monthly/yearly variants for Pro in
# your Lemon Squeezy store, then set the server-side identifiers and API key.
# Test mode should be used until checkout + webhook flows have been verified.
# ---------------------------------------------------------------------------
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_PRO_MONTHLY_VARIANT_ID=
LEMON_SQUEEZY_PRO_YEARLY_VARIANT_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=

# Optional. Enables privacy-preserving aggregate product metrics at
# /admin/metrics for this account only. Must exactly match a verified account.
ANALYTICS_ADMIN_EMAIL=

# ---------------------------------------------------------------------------
# Email — Resend is preferred when both Resend variables are configured.
# Create an API key and verify the sender domain in Resend, then configure these
# values in your deployment environment. SMTP can be used as a fallback.
RESEND_API_KEY=
RESEND_FROM=
#
# SMTP fallback. Port 587 (the default) requires STARTTLS — credentials are
# never written to a plaintext connection; port 465 uses implicit TLS.
#
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---------------------------------------------------------------------------
# Brand — optional. Shown in the UI and in emails. The product name defaults to
# "VisionSpeak"; set these only when white-labelling a deployment.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_BRAND_NAME=
NEXT_PUBLIC_BRAND_TAGLINE=

# ---------------------------------------------------------------------------
# Legal / support — shown on /privacy and /terms and used for deletion requests.
# Set these to real values before you take money or traffic.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_LEGAL_ENTITY=
NEXT_PUBLIC_LEGAL_JURISDICTION=
